      "license": "CC0",
      "landing_page": "https://docs.openalex.org/api-entities/institutions",
      "keywords": ["research", "lab", "laboratory", "university research"],
      "search": {
        "needs": "locality",
        "url": "https://api.openalex.org/institutions",
        "params": { "filter": "geo.city:{locality},country_code:US", "sort": "works_count:desc", "per_page": "{limit}", "select": "id,display_name,homepage_url,type,works_count,geo", "api_key": "{env.OPENALEX_API_KEY}" },
        "records": "results",
        "total": "meta.count",
        "sort_by_distance": false,
        "fields": {
          "id": { "path": "id", "transform": "last_segment" },
          "name": "display_name",
          "url": ["homepage_url", "id"],
