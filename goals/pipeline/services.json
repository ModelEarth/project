      "keywords": ["makerspace", "hackerspace", "coworking", "maker", "workspace"],
      "search": { "needs": "point", "tags": ["leisure=hackerspace", "amenity=coworking_space", "office=coworking"], "radius_miles": 10, "max_radius_miles": 25 }
    },
    {
      "id": "github-developers",
