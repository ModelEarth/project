        "max_radius_miles": 200,
        "sort_by_distance": false,
        "fields": {
          "id": "id",
          "name": "name",
          "street": "address",
          "locality": "city",
          "region": "state",
          "postal_code": "zip",
          "phone": "phone",
          "url": "website",
          "lat": "lat",
          "lng": "lng",
          "distance_miles": ["distance", "distance_miles"],
          "type": "resource_type",
          "subtype": "resource_subtype",
          "services": "services",
          "notes": "notes",
          "relevance": "veteran_relevance",
          "completeness_score": "completeness_score"
