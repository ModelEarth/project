      "keywords": ["grant", "nsf", "funding", "award"],
      "entity_type": "offering",
      "search": {
        "needs": "locality",
        "url": "https://api.nsf.gov/services/v1/awards.json",
        "params": { "awardeeCity": "{locality}", "awardeeStateCode": "{region}", "keyword": "{keywords}", "rpp": "{limit}", "printFields": "id,title,awardeeName,awardeeCity,awardeeStateCode,startDate,fundsObligatedAmt" },
        "records": "response.award",
        "sort_by_distance": false,
        "fields": {
          "id": "id",
          "name": "title",
          "detail": "awardeeName",
          "locality": { "path": "awardeeCity", "transform": "title_case" },
          "region": "awardeeStateCode",
          "url": { "template": "https://www.nsf.gov/awardsearch/showAward?AWD_ID={id}" },
          "label": { "template": "NSF award from {startDate}" }
        }
      }
    },
    {
      "id": "wikipedia-nearby",
      "title": "Places with Wikipedia articles",
      "short": "Places nearby",
      "summary": "Landmarks, buildings and historic sites near a point, for walking tours and field trips",
      "categories": ["field_trips"],
      "status": "live",
      "kind": "rest",
      "publisher": "Wikipedia",
      "license": "CC BY-SA 4.0",
      "landing_page": "https://www.mediawiki.org/wiki/Extension:GeoData",
      "keywords": ["field trip", "landmark", "history", "historic", "walking tour"],
      "search": {
        "needs": "point",
        "url": "https://en.wikipedia.org/w/api.php",
        "params": { "action": "query", "list": "geosearch", "gscoord": "{lat}|{lng}", "gsradius": "{radius_m}", "gslimit": "{limit}", "format": "json" },
        "records": "query.geosearch",
        "radius_miles": 3,
        "max_radius_miles": 6,
