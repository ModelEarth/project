      "entity_type": { "vso": "organization", "*": "offering" },
      "search": {
        "needs": null,
        "variants": [
          { "when": ["text"], "tool": "search_veteran_resources_by_text", "args": { "q": "{text}", "zip": "{postal_code}", "type": "{category_upstream}", "state": "{region}", "specialty": "{specialty}", "limit": "{limit}" } },
          { "when": ["postal_code"], "tool": "search_veteran_resources", "args": { "zip": "{postal_code}", "type": "{category_upstream|all}", "specialty": "{specialty}", "radius": "{radius_miles}", "limit": "{limit}" } },
          { "when": ["locality"], "tool": "search_by_city", "args": { "city": "{locality}", "state": "{region}", "type": "{category_upstream}", "radius": "{radius_miles}", "limit": "{limit}" } }
