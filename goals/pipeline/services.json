    {
      "id": "openalex-institutions",
      "title": "Research institutions",
      "short": "Research",
      "summary": "Universities, labs and companies in your city that publish research, ranked by works published",
      "categories": ["research", "collaborate"],
      "status": "live",
      "kind": "rest",
