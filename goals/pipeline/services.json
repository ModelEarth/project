{
  "schema_version": "1.0",
  "note": "Location-based services the goals page and MCP server search through one generic tool (search_nearby). Each service's search block (with variants chosen by which request values are present, a prelude for a value looked up first, where to keep only matching items, and relax for values dropped when nothing matches) maps a place (ZIP, city, region or point) to an upstream MCP tool, REST API or OpenStreetMap query, and maps the upstream's records to claim-level records (fields). Templates: {name} or {name|default} from the request (postal_code, locality, region, lat, lng, radius_miles, radius_m, radius_km, limit, text, keywords, keyword, language) and {env.NAME} from Worker secrets. status: live, key (live once requires_env is set) or planned. featured: the 10 checkboxes under the page's lede; default_selected: checked on a first visit.",
  "audiences": [
    { "id": "students", "label": "Students" },
    { "id": "teachers", "label": "Teachers" },
    { "id": "ai_coders", "label": "AI coders" },
    { "id": "veterans", "label": "Veterans" },
    { "id": "everyone", "label": "Everyone" }
  ],
  "categories": [
    { "id": "jobs", "title": "Jobs and careers", "audiences": ["everyone", "students", "ai_coders", "veterans"] },
    { "id": "training", "title": "College and training", "audiences": ["students", "teachers", "veterans"] },
    { "id": "schools", "title": "Schools and learning", "audiences": ["teachers", "students"] },
    { "id": "collaborate", "title": "AI coders and collaboration", "audiences": ["ai_coders", "students"] },
    { "id": "research", "title": "Research, grants and labs", "audiences": ["teachers", "students", "ai_coders"] },
    { "id": "spaces", "title": "Makerspaces, coworking and libraries", "audiences": ["ai_coders", "students", "teachers"] },
    { "id": "field_trips", "title": "Places, nature and field trips", "audiences": ["teachers", "students"] },
    { "id": "veterans", "title": "Veteran services", "audiences": ["veterans"] },
    { "id": "health", "title": "Health and care", "audiences": ["everyone", "veterans"] },
    { "id": "housing", "title": "Housing", "audiences": ["everyone", "veterans"] },
    { "id": "food", "title": "Food", "audiences": ["everyone"] },
    { "id": "community", "title": "Community and nonprofits", "audiences": ["everyone", "teachers"] },
    { "id": "alerts", "title": "Alerts and disasters", "audiences": ["everyone"] },
    { "id": "getting_around", "title": "Getting around", "audiences": ["everyone"] }
  ],
  "featured": ["hn-hiring", "jobicy-remote", "veteran-job-centers", "college-scorecard", "nces-public-schools", "osm-libraries", "osm-makerspaces", "github-developers", "openalex-institutions", "hud-housing-counselors"],
  "default_selected": [],
  "services": [
    {
      "id": "hn-hiring",
      "title": "Tech jobs by city",
      "short": "Tech jobs",
      "summary": "This month's Hacker News \"Who is hiring?\" posts that name your city, with a programming language from your words",
      "categories": ["jobs", "collaborate"],
      "status": "live",
      "kind": "rest",
      "publisher": "Hacker News, searched through Algolia",
      "license": "Posts belong to their authors; each result links to the original",
      "landing_page": "https://hn.algolia.com/api",
      "keywords": ["tech job", "software job", "developer job", "engineer", "hiring", "startup"],
      "entity_type": "offering",
      "search": {
        "needs": "locality",
        "prelude": {
          "url": "https://hn.algolia.com/api/v1/search_by_date",
          "params": { "tags": "story,author_whoishiring", "hitsPerPage": "6" },
          "records": "hits",
          "match": { "title": "Who is hiring" },
          "vars": { "story_id": "objectID", "story_title": "title" }
        },
        "url": "https://hn.algolia.com/api/v1/search",
        "params": { "tags": "comment,story_{story_id}", "query": "{locality} {language|}", "hitsPerPage": "50" },
        "records": "hits",
        "where": { "parent_id": "{story_id}" },
        "total": "nbHits",
        "relax": ["language"],
        "sort_by_distance": false,
        "fields": {
          "id": "objectID",
          "name": { "path": "comment_text", "transform": ["first_paragraph", "strip_html", "clip_short"] },
          "detail": { "path": "comment_text", "transform": ["after_first_paragraph", "strip_html", "clip"] },
          "label": { "template": "{story_title}" },
          "url": { "template": "https://news.ycombinator.com/item?id={objectID}" },
          "date": { "path": "created_at", "transform": "date" }
        }
      }
    },
    {
      "id": "usajobs",
      "title": "Federal jobs (USAJOBS)",
      "short": "Federal jobs",
      "summary": "Federal job openings within a radius of your city, by keyword, including veterans' preference jobs",
      "categories": ["jobs", "veterans"],
      "status": "key",
      "requires_env": ["USAJOBS_API_KEY", "USAJOBS_EMAIL"],
      "kind": "rest",
      "publisher": "U.S. Office of Personnel Management",
      "license": "U.S. Government work, public domain",
      "landing_page": "https://developer.usajobs.gov/",
      "keywords": ["federal job", "government job", "usajobs"],
      "entity_type": "offering",
      "search": {
        "needs": "locality",
        "url": "https://data.usajobs.gov/api/search",
        "params": { "Keyword": "{keywords}", "LocationName": "{locality}, {region}", "Radius": "{radius_miles}", "ResultsPerPage": "{limit}" },
        "headers": { "Authorization-Key": "{env.USAJOBS_API_KEY}", "User-Agent": "{env.USAJOBS_EMAIL}" },
        "records": "SearchResult.SearchResultItems",
        "total": "SearchResult.SearchResultCountAll",
        "radius_miles": 25,
        "fields": {
          "id": "MatchedObjectId",
          "name": "MatchedObjectDescriptor.PositionTitle",
          "detail": "MatchedObjectDescriptor.OrganizationName",
          "locality": "MatchedObjectDescriptor.PositionLocation.0.CityName",
          "url": "MatchedObjectDescriptor.PositionURI",
          "lat": "MatchedObjectDescriptor.PositionLocation.0.Latitude",
          "lng": "MatchedObjectDescriptor.PositionLocation.0.Longitude",
          "label": { "value": "Federal job" }
        }
      }
    },
    {
      "id": "veteran-job-centers",
      "title": "American Job Centers and employment help",
      "short": "Job centers",
      "summary": "Job centers, employment programs and training near a ZIP, from the veteran resource directory's employment listings",
      "categories": ["jobs", "veterans"],
      "status": "live",
      "kind": "mcp",
      "extends": "veteran-directory",
      "keywords": ["job center", "career center", "employment help", "job training"],
      "vars": { "category_upstream": "employment" }
    },
    {
      "id": "jobicy-remote",
      "title": "Remote jobs (U.S.)",
      "short": "Remote jobs",
      "summary": "Remote openings for U.S. residents, matched to a keyword from your words",
      "categories": ["jobs", "collaborate"],
      "status": "live",
      "kind": "rest",
      "publisher": "Jobicy",
      "license": "Credit Jobicy and link each job to its original listing",
      "landing_page": "https://jobicy.com/jobs-rss-feed",
      "keywords": ["remote job", "work from home"],
      "entity_type": "offering",
      "search": {
        "needs": null,
        "url": "https://jobicy.com/api/v2/remote-jobs",
        "params": { "count": "{limit}", "geo": "usa", "tag": "{keyword}" },
        "records": "jobs",
        "sort_by_distance": false,
        "fields": {
          "id": "id",
          "name": "jobTitle",
          "detail": { "join": ["companyName", "jobLevel"], "sep": " · " },
          "label": { "template": "Remote, {jobGeo}" },
          "url": "url",
          "date": { "path": "pubDate", "transform": "date" }
        }
      }
    },
    {
      "id": "osm-employment",
      "title": "Employment offices (OpenStreetMap)",
      "short": "Employment offices",
      "summary": "Employment agencies and public employment offices mapped in OpenStreetMap",
      "categories": ["jobs"],
      "status": "live",
      "kind": "overpass",
      "publisher": "OpenStreetMap contributors",
      "license": "ODbL 1.0",
      "landing_page": "https://www.openstreetmap.org/copyright",
      "keywords": ["employment office", "staffing agency"],
      "search": { "needs": "point", "tags": ["office=employment_agency", "office=government,government=employment"], "radius_miles": 10, "max_radius_miles": 25 }
    },
    {
      "id": "college-scorecard",
      "title": "Colleges and training programs",
      "short": "Colleges",
      "summary": "Colleges, community colleges and technical schools near a ZIP, with their main credential and enrollment",
      "categories": ["training", "schools"],
      "status": "live",
      "kind": "rest",
      "publisher": "U.S. Department of Education, College Scorecard",
      "license": "U.S. Government work, public domain",
      "landing_page": "https://collegescorecard.ed.gov/data/api/",
      "keywords": ["college", "university", "community college", "technical school", "degree", "certificate"],
      "search": {
        "needs": "postal_code",
        "url": "https://api.data.gov/ed/collegescorecard/v1/schools",
        "params": {
          "zip": "{postal_code}",
          "distance": "{radius_miles}mi",
          "api_key": "{env.DATA_GOV_API_KEY|DEMO_KEY}",
          "school.operating": "1",
          "fields": "id,school.name,school.city,school.state,school.zip,school.school_url,location.lat,location.lon,latest.student.size,school.degrees_awarded.predominant",
          "per_page": "50"
        },
        "records": "results",
        "total": "metadata.total",
        "radius_miles": 15,
        "max_radius_miles": 100,
        "fields": {
          "id": "id",
          "name": "school.name",
          "locality": "school.city",
          "region": "school.state",
          "postal_code": { "path": "school.zip", "transform": "zip5" },
          "url": { "path": "school.school_url", "transform": "https" },
          "lat": "location.lat",
          "lng": "location.lon",
          "label": { "path": "school.degrees_awarded.predominant", "map": { "0": "College", "1": "Certificates", "2": "Associate degrees", "3": "Bachelor's degrees", "4": "Graduate degrees" } },
          "detail": { "template": "{latest.student.size} undergraduates" }
        }
      }
    },
    {
      "id": "nces-public-schools",
      "title": "Public schools (NCES)",
      "short": "Schools",
      "summary": "Public K-12 schools near you, from the National Center for Education Statistics school locations",
      "categories": ["schools"],
      "status": "live",
      "kind": "rest",
      "publisher": "National Center for Education Statistics, EDGE",
      "license": "U.S. Government work, public domain",
      "landing_page": "https://nces.ed.gov/programs/edge/Geographic/SchoolLocations",
      "keywords": ["school", "k-12", "elementary", "middle school", "high school", "classroom"],
      "search": {
        "needs": "point",
        "url": "https://nces.ed.gov/opengis/rest/services/K12_School_Locations/EDGE_GEOCODE_PUBLICSCH_2324/MapServer/0/query",
        "params": {
          "where": "1=1",
          "geometry": "{lng},{lat}",
          "geometryType": "esriGeometryPoint",
          "inSR": "4326",
          "distance": "{radius_miles}",
          "units": "esriSRUnit_StatuteMile",
          "outFields": "NCESSCH,NAME,STREET,CITY,STATE,ZIP,LAT,LON,NMCNTY",
          "returnGeometry": "false",
          "resultRecordCount": "200",
          "f": "json"
        },
        "records": "features",
        "radius_miles": 3,
        "max_radius_miles": 25,
        "fields": {
          "id": "attributes.NCESSCH",
          "name": "attributes.NAME",
          "street": "attributes.STREET",
          "locality": "attributes.CITY",
          "region": "attributes.STATE",
          "postal_code": "attributes.ZIP",
          "lat": "attributes.LAT",
          "lng": "attributes.LON",
          "label": { "value": "Public school" },
          "source_url": { "template": "https://nces.ed.gov/ccd/schoolsearch/school_detail.asp?ID={attributes.NCESSCH}" }
        }
      }
    },
    {
